{
    "name": "ticketfile",
    "displayName": "Ticket Explorer",
    "description": "Manage plain-text tickets from Visual Studio Code.",
    "version": "0.0.1",
    "publisher": "mackron",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ticketfile",
                    "title": "Ticket Explorer",
                    "icon": "resources/ticket.svg"
                }
            ]
        },
        "views": {
            "ticketfile": [
                {
                    "id": "ticketfile.tickets",
                    "name": "Tickets"
                }
            ]
        },
        "commands": [
            {
                "command": "ticketfile.refresh",
                "title": "Refresh Tickets",
                "icon": "$(refresh)"
            },
            {
                "command": "ticketfile.createTicket",
                "title": "Create Ticket",
                "icon": "$(add)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "ticketfile.createTicket",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@1"
                },
                {
                    "command": "ticketfile.refresh",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@2"
                }
            ]
        },
        "configuration": {
            "title": "Ticket Explorer",
            "properties": {
                "ticketfile.ticketsFolder": {
                    "type": "string",
                    "default": "tickets",
                    "description": "Path to the tickets folder, relative to the first folder in the workspace."
                }
            }
        }
    }
}
