{
    "name": "ticketfile",
    "displayName": "Ticket Explorer",
    "description": "Manage plain-text tickets from Visual Studio Code.",
    "version": "0.0.1",
    "publisher": "mackron",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "scripts": {
        "test": "node ticket_parser.test.js"
    },
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ticketfile",
                    "title": "Ticket Explorer",
                    "icon": "resources/ticket.svg"
                }
            ]
        },
        "views": {
            "ticketfile": [
                {
                    "id": "ticketfile.tickets",
                    "name": "Tickets"
                }
            ]
        },
        "commands": [
            {
                "command": "ticketfile.refresh",
                "title": "Refresh Tickets",
                "icon": "$(refresh)"
            },
            {
                "command": "ticketfile.filterTickets",
                "title": "Filter Tickets",
                "icon": "$(filter)"
            },
            {
                "command": "ticketfile.clearFilter",
                "title": "Clear Ticket Filter",
                "icon": "$(clear-all)",
                "enablement": "ticketfile.hasFilter"
            },
            {
                "command": "ticketfile.createTicket",
                "title": "Create Ticket",
                "icon": "$(add)"
            },
            {
                "command": "ticketfile.openTicket",
                "title": "Open Ticket",
                "icon": "$(go-to-file)"
            },
            {
                "command": "ticketfile.addComment",
                "title": "Add Comment",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "ticketfile.closeTicket",
                "title": "Close Ticket",
                "icon": "$(issue-closed)"
            },
            {
                "command": "ticketfile.reopenTicket",
                "title": "Reopen Ticket",
                "icon": "$(history)"
            },
            {
                "command": "ticketfile.deleteTicket",
                "title": "Delete Ticket",
                "icon": "$(trash)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "ticketfile.filterTickets",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@1"
                },
                {
                    "command": "ticketfile.clearFilter",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@2"
                },
                {
                    "command": "ticketfile.createTicket",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@3"
                },
                {
                    "command": "ticketfile.refresh",
                    "when": "view == ticketfile.tickets",
                    "group": "navigation@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "ticketfile.openTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /Ticket$/",
                    "group": "inline@0"
                },
                {
                    "command": "ticketfile.closeTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(open|uncategorized)Ticket$/",
                    "group": "inline@1"
                },
                {
                    "command": "ticketfile.reopenTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(closed|uncategorized)Ticket$/",
                    "group": "inline@1"
                },
                {
                    "command": "ticketfile.addComment",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(open|closed|uncategorized)Ticket$/",
                    "group": "inline@2"
                },
                {
                    "command": "ticketfile.openTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /Ticket$/",
                    "group": "navigation@1"
                },
                {
                    "command": "ticketfile.closeTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(open|uncategorized)Ticket$/",
                    "group": "1_modification@1"
                },
                {
                    "command": "ticketfile.reopenTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(closed|uncategorized)Ticket$/",
                    "group": "1_modification@1"
                },
                {
                    "command": "ticketfile.addComment",
                    "when": "view == ticketfile.tickets && viewItem =~ /^(open|closed|uncategorized)Ticket$/",
                    "group": "1_modification@2"
                },
                {
                    "command": "ticketfile.deleteTicket",
                    "when": "view == ticketfile.tickets && viewItem =~ /Ticket$/",
                    "group": "2_danger@1"
                }
            ]
        },
        "configuration": {
            "title": "Ticket Explorer",
            "properties": {
                "ticketfile.ticketsFolder": {
                    "type": "string",
                    "default": "tickets",
                    "description": "Path to the tickets folder, relative to the first folder in the workspace."
                }
            }
        }
    }
}
