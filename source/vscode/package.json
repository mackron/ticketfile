{
    "name": "ticketfile",
    "displayName": "Ticket Explorer",
    "description": "Manage plain-text tickets from Visual Studio Code.",
    "version": "0.0.1",
    "publisher": "mackron",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
